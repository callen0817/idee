# Browser/build configuration. Copy the existing public settings privately.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server runtime configuration for the same existing Cloud backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Current app does not call privileged admin or cron helpers. If you later
# add such features, configure their credentials only on the server host.
# Cloud service-role credentials are not exportable from Lovable Cloud.

# GitHub credentials are for development only, never an app requirement.